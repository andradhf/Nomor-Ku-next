# Salin ke .env.docker dan isi sebelum build.
# Semua NEXT_PUBLIC_* berikut dapat dilihat browser, jangan isi secret key.
NEXT_PUBLIC_API_BASE_URL=https://akrilo-backend-hono-production.up.railway.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=ganti-dengan-site-key-turnstile
NEXT_PUBLIC_SITE_URL=https://nomorku.example.com
NEXT_PUBLIC_WA_NUMBER=6281234567890

# Default: diakses lewat reverse proxy pada host server yang sama.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
